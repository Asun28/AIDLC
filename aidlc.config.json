{
  "schemaVersion": 1,
  "cardsDir": "specs/tasks",
  "archiveDir": "specs/archive/tasks",
  "intentDir": "intent",
  "specsDir": "specs",
  "plansDir": "plans",
  "worktreeRoot": "D:\\wt\\AIDLC",
  "base": "main",
  "mode": "remote",
  "shipPath": "github",
  "reviewPool": "default",
  "reviewPolicyVersion": "REVIEW.md@3",
  "reviewer": "reviewer",
  "maxWorkers": 2,
  "family": "claude",
  "provider": "mock",
  "repository": "Asun28/AIDLC",
  "github": {
    "requiredChecks": [
      "check (ubuntu-latest, 22)",
      "check (windows-latest, 22)",
      "build-test",
      "Gitleaks (committed history)"
    ],
    "requireVerdict": true
  },
  "hooks": {
    "frozenPaths": [],
    "testPathPatterns": [
      "(^|/)tests?/",
      "\\.test\\.[cm]?[jt]sx?$",
      "\\.spec\\.[cm]?[jt]sx?$",
      "_test\\.(py|go|kt)$",
      "(^|/)src/test/"
    ],
    "productionPatterns": [
      "\\b(deploy|release|rollout|promote|apply)\\b[^\\n]*\\b(prod|production|live)\\b",
      "\\b(prod|production)\\b[^\\n]*\\b(deploy|release|rollout|promote|apply)\\b"
    ]
  },
  "tierPaths": {
    "tierS": [],
    "tier0": [],
    "frozen": []
  },
  "preReview": {
    "command": [
      "deepseek",
      "--model",
      "deepseek-v4-pro"
    ],
    "reviewer": "deepseek-v4-pro",
    "coverage": "shadow",
    "rounds": 3,
    "timeoutMs": 1200000,
    "onExhausted": "ship",
    "perspectives": [
      "ac-coverage",
      "spec-deviations",
      "edge-cases"
    ],
    "maxDiffBytes": 800000
  },
  "gateRequired": true,
  "formalReview": {
    "command": [
      "codex",
      "exec",
      "--sandbox",
      "read-only",
      "--output-schema",
      "{schema}"
    ],
    "reviewer": "codex",
    "timeoutMs": 1200000,
    "maxDiffBytes": 800000
  }
}
