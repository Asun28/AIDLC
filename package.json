{
  "name": "aidlc",
  "version": "0.2.0",
  "description": "AI-native SDLC orchestrator: intent -> spec -> plan -> cards -> verified delivery, with bounded autonomy, shared-session coordination and auditable evidence.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "aidlc": "./bin/aidlc.js",
    "aidlc-hook": "./bin/aidlc-hook.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "check:tree": "node --test tests/core/parse-guard.test.ts tests/infra/update-json.test.ts tests/surface/layers.test.ts tests/surface/mirror.test.ts tests/surface/module-map.test.ts tests/surface/prose.test.ts tests/surface/test-audit.test.ts tests/surface/test-temp.test.ts",
    "dev": "node src/cli/main.ts",
    "evals": "node src/cli/main.ts evals run",
    "bench": "node bench/run.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "commander": "^14.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  }
}
