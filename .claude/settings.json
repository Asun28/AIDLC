{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/*.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(./auth/**)",
      "Read(**/.secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.keystore)",
      "Read(**/id_rsa*)",
      "Read(**/*credentials*.json)",
      "Read(**/service-account*.json)",
      "Read(**/*.secret)",
      "Read(**/*storage_state*.json)",
      "Read(~/.ssh/**)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git clean -*f*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(* --no-verify*)",
      "PowerShell(git reset --hard)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git clean -*f*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(* --no-verify*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/aidlc-hook.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node bin/aidlc-hook.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node bin/aidlc-hook.js"
          }
        ]
      }
    ]
  }
}
